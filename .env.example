# ── LinkedIn OAuth ───────────────────────────────────────────────────────────
# Create an OAuth app at https://www.linkedin.com/developers/apps
# Required products: "Sign In with LinkedIn using OpenID Connect" + "Marketing
# Developer Platform" (for ads scopes). Add the callback URL below to the
# Authorized Redirect URLs in the LinkedIn app settings.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Where LinkedIn should redirect after the user signs in.
# Defaults to ${BASE_URL}/oauth/callback if unset.
# LINKEDIN_REDIRECT_URI=http://localhost:8080/oauth/callback

# ── Server identity ──────────────────────────────────────────────────────────
# Public URL where this service is reachable. Used for OAuth metadata
# (issuer, authorization_endpoint, token_endpoint) and the canonical
# resource URI MCP clients bind their tokens to.
# Local dev: http://localhost:8080
# Cloud Run: https://your-service-xxxx.run.app
BASE_URL=http://localhost:8080

# ── Firestore (token storage) ────────────────────────────────────────────────
# GCP project hosting the Firestore database. Required for HTTP server mode.
# Not required for local STDIO mode (see README — npm run auth + npm start).
GCP_PROJECT_ID=

# ── Access control (optional) ────────────────────────────────────────────────
# Comma-separated list of LinkedIn-account emails permitted to authenticate.
# LinkedIn returns whatever email the user signed up with (often personal
# rather than work), so domain-based allowlisting isn't useful here.
# Empty/unset = anyone with a LinkedIn account may connect (but they only
# see ad accounts their LinkedIn profile has access to).
# Example: ALLOWED_EMAILS=alice@gmail.com,bob@hotmail.com
ALLOWED_EMAILS=

# ── Local STDIO mode only ────────────────────────────────────────────────────
# These are used by the legacy single-user local mode (src/index.ts +
# src/auth-cli.ts). Not relevant when deploying to Cloud Run.
# TOKEN_STORAGE_PATH=/custom/path/to/tokens.json
# LINKEDIN_TOKENS_JSON={"access_token":"...","refresh_token":"...","expires_at":...}

# ── Server tuning ────────────────────────────────────────────────────────────
# PORT=8080
